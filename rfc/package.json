{
	"name": "rfc",
	"version": "1.0.0",
	"scripts": {
		"build:site": "bun ./build-site.ts",
		"check:anchors": "bun ./check-anchors.ts",
		"generate": "bun run --sequential render:tree-fucker check:anchors",
		"render:tree-fucker": "bun ./render-tree-fucker.ts",
		"site": "bun run --sequential generate build:site",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^7"
	},
	"packageManager": "bun@1.4.0",
	"devEngines": {
		"packageManager": [{ "name": "bun", "version": ">=1.4" }],
		"runtime": [{ "name": "bun", "version": ">=1.4" }]
	}
}
