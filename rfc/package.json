{
	"name": "rfc",
	"version": "1.0.0",
	"imports": {
		"#rfc.txt": "./tree-fucker.txt",
		"#pkg": "./package.json"
	},
	"scripts": {
		"build:site": "bun ./src/build-site.ts",
		"postbuild:site": "bun --silent check:anchors",
		"check:anchors": "bun ./src/check-anchors.ts",
		"site": "bun run --sequential build:site check:anchors",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/bun": "catalog:site",
		"typescript": "catalog:site",
		"vite-svg-to-ico": "catalog:site"
	},
	"devEngines": {
		"packageManager": { "name": "bun", "version": ">=1.4" },
		"runtime": { "name": "bun", "version": ">=1.4" }
	}
}
