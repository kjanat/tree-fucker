{
	"$schema": "https://beepboop.kjanat.dev/schema/v1.json",
	"managers": [
		"cargo",
		"github-release",
		"workflow"
	],
	"streams": {
		"main": {
			"versioning": "workspace",
			"packages": ["cargo:tree-fucker"],
			"prepare": {
				"version": "manual",
				"strategy": "managed",
				"workflow": {
					"file": "release-prepare.yml",
					"ref": "master",
					"mode": "dispatch"
				}
			},
			"promote": {
				"approval": "required",
				"workflow": {
					"file": "release.yml",
					"ref": "master",
					"mode": "dispatch",
					"publications": ["cargo:tree-fucker", "github-release:kjanat/tree-fucker"],
					"refs": { "phase": "version", "prefix": "v" }
				}
			},
			"workflows": {},
			"credentials": ["crates-io"],
			"required": [
				"cargo:tree-fucker",
				"github-release:kjanat/tree-fucker"
			]
		}
	}
}
