{
  "$schema": "https://beepboop.kjanat.dev/schema/v1.json",
  "managers": ["cargo", "github-release", "workflow"],
  "streams": {
    "main": {
      "versionScope": "one-for-stream",
      "packages": ["pkg:cargo/tree-fucker"],
      "promote": {
        "publishWhen": "version-commit-pushed",
        "workflow": {
          "file": "release.yml",
          "ref": "master",
          "mode": "dispatch",
          "publications": [
            "pkg:cargo/tree-fucker",
            "github-release:kjanat/tree-fucker"
          ],
          "refs": {
            "phase": "version",
            "prefix": "v"
          }
        }
      },
      "workflows": {},
      "credentials": ["crates-io"],
      "mustPublish": [
        "pkg:cargo/tree-fucker",
        "github-release:kjanat/tree-fucker"
      ]
    }
  }
}
