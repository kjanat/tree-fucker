{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"extends": "https://cdn.jsdelivr.net/gh/kjanat/kjanat@master/configs/dprint.remote.json",
	"useTabs": true,
	"jsonSchemaSort": { "associations": ["**/schema.json", "**/*.schema.json"] },
	"json": { "trailingCommas": "maintain" },
	"typescript": { "lineWidth": 150 },
	"markdown": { "textWrap": "never", "emphasisKind": "asterisks" },
	"markup": { "associations": ["!**/*.svg"] },
	"ruff": { "preview": true },
	"yaml": { "printWidth": 160 },
	"exec": {
		"cwd": "${configDir}",
		"cacheKey": "1",
		"timeout": 30,
		"commands": [
			{
				"command": "rustfmt",
				"exts": ["rs"],
				"cacheKeyFiles": ["rustfmt.toml"],
				"setupCommand": "rustup component add rustfmt"
			}
		]
	},
	"excludes": [
		"**/*.hbs",
		"**/*.lock",
		"**/fixtures",
		"**/node_modules",
		"**/target",
		"**/test_data",
		"crates/gpui_web/examples/hello_web/.cargo/config.toml",
		"nix/livekit-libwebrtc/update.sh",
		"script/lib/deploy-helpers.sh",
	]
}
